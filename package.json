{
  "name": "kaavatietomalli-website",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist",
    "clean:test": "rm -rf test-public",
    "fetch-data-models": "tsx scripts/fetch-data-models.ts",
    "fetch-data-models:test": "CONTENT_MODE=test tsx scripts/fetch-data-models.ts",
    "fetch-codelists": "tsx scripts/fetch-codelists.ts",
    "fetch-codelists:test": "CONTENT_MODE=test tsx scripts/fetch-codelists.ts",
    "fetch-data": "tsx scripts/fetch-data.ts",
    "fetch-data:test": "CONTENT_MODE=test tsx scripts/fetch-data.ts",
    "fetch-giscus-stats": "tsx scripts/fetch-giscus-stats.ts",
    "validate-content": "tsx scripts/validate-markdown-content.ts",
    "validate-content:test": "CONTENT_MODE=test tsx scripts/validate-markdown-content.ts",
    "check-codelists": "tsx scripts/list-missing-codelists.ts",
    "prebuild": "tsx scripts/sync-git-version.ts && tsx scripts/generate-assets.ts && tsx scripts/generate-search-index.ts",
    "prebuild:test": "tsx scripts/sync-git-version.ts && CONTENT_MODE=test tsx scripts/generate-assets.ts && CONTENT_MODE=test tsx scripts/generate-search-index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "prepare:test": "npm run clean:test && npm run fetch-data:test && npm run prebuild:test",
    "lint": "tsc --noEmit",
    "test": "npm run prepare:test && CONTENT_MODE=test vitest",
    "test:run": "npm run prepare:test && CONTENT_MODE=test vitest run",
    "test:e2e": "npm run prepare:test && CONTENT_MODE=test playwright test",
    "cdk:synth": "cdk synth",
    "cdk:deploy": "cdk deploy --all",
    "cdk:destroy": "cdk destroy --all",
    "ci:validate": "tsc --noEmit && vite build --outDir /tmp/vite-check && rm -rf /tmp/vite-check",
    "check-markdown-language": "tsx scripts/check-markdown-language.ts --dir=content"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@mermaid-js/layout-elk": "^0.2.2",
    "@orama/orama": "^3.1.18",
    "@orama/stemmers": "^3.1.18",
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "js-yaml": "^5.2.3",
    "katex": "^0.18.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.16.1",
    "motion": "^12.38.0",
    "proj4": "^2.20.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.20.1",
    "@types/proj4": "^2.5.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@yongsk0066/voikko": "^0.4.0",
    "autoprefixer": "^10.4.21",
    "aws-cdk": "^2.1137.0",
    "aws-cdk-lib": "^2.265.0",
    "constructs": "^10.8.1",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.2.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.7"
  }
}
