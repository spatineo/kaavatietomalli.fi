        {
            "@id": "ryhti-tont:Organisaatio",
            "suomi-meta:publicationStatus": {
                "@id": "http://yti-fuseki-v4:3031/core/VALID"
            },
            "suomi-meta:modifier": "a33fddce-0ae4-4439-9655-12e39c2a1db7",
            "@type": "sh:NodeShape",
            "rdfs:comment": [
                {
                    "@language": "fi",
                    "@value": "Organisaatiolla tarkoitetaan tiettyä toimintaa varten perustettua sosiaalista järjestelmää, jolla on määritellyt tavoitteet ja tarkoituksellisesti luotu rakenne. Organisaatio-luokka kattaa mm. kaikki yritysmuodot ja kaikki rekisteröidyt organisaatiot, jotka yleensä ovat oikeushenkilöitä, mutta myös löyhemmät ryhmittymät joilla ei ole virallista statusta."
                },
                {
                    "@language": "en",
                    "@value": "a social system set up for a specific purpose/for a specific activity, which has defined objectives and a deliberately created structure"
                },
                {
                    "@language": "sv",
                    "@value": "Med organisation avses ett socialt system som har grundats i ett specifikt syfte och som har fastställda mål och en ändamålsenligt uppbyggd struktur. Klassen Organisation omfattar bl.a. alla företagsformer och alla registrerade organisationer, som vanligen är juridiska personer, men också lösare grupperingar utan officiell status."
                }
            ],
            "rdfs:isDefinedBy": {
                "@id": "https://iri.suomi.fi/model/ryhti-tont/"
            },
            "rdfs:label": [
                {
                    "@language": "fi",
                    "@value": "Organisaatio"
                },
                {
                    "@language": "en",
                    "@value": "Organization"
                },
                {
                    "@language": "sv",
                    "@value": "Organisation"
                }
            ],
            "dcterms:created": "2024-01-30T15:05:04.245Z",
